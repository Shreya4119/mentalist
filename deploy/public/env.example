# Copy to .env in the project root (or run deploy/public/make-env.sh, which
# fills in the secrets for you). Never commit .env: it is git-ignored.

# The address of your site, e.g. mentalist.duckdns.org or mentalist.example.nl
DOMAIN=

# Google AI Studio key (https://aistudio.google.com/apikey). Use a paid-tier
# key with a monthly budget so visitors' questions aren't used for training.
GEMINI_API_KEY=

# Random secrets: generate with `openssl rand -base64 36`
POSTGRES_PASSWORD=
JWT_SECRET=

# Your owner sign-in password (username: admin), at least 12 characters.
ADMIN_PASSWORD=

# Sign-up: set to false to stop new accounts (existing ones keep working)
SIGNUP_ENABLED=true
MAX_USERS=1000

# Daily AI allowance per person, and for the whole site (reset at midnight, Amsterdam time)
LIMIT_ANALYSES_PER_USER_PER_DAY=3
LIMIT_QUESTIONS_PER_USER_PER_DAY=30
LIMIT_ANALYSES_PER_DAY=60
LIMIT_QUESTIONS_PER_DAY=900
